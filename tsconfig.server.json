{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@server/*": ["./server/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "server/src/**/*",
    "server/tests/**/*",
    "shared/**/*"
  ],
  "exclude": ["client/**/*", "node_modules"]
}
